<?xml version="1.0"?>
<package format="3">
  <name>autonomous_robot_localization_pkg</name>
  <version>0.0.1</version>
  <description>Paquete para estimación de posición y streaming de cámara</description>

  <maintainer email="davdthor@gmail.com">David Thomas</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencias ROS -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <!-- Dependencias de sistema -->
  <depend>libopencv-dev</depend>
  <depend>libeigen3-dev</depend>
  <depend>libyaml-cpp-dev</depend>
  <depend>libcamera-dev</depend>
  <build_depend>pkg-config</build_depend>

  <!-- Launch and replay runtime dependencies -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <!-- Dependencias de test -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
